[sub_resource type="GDScript" id="GDScript_ud1fw"]
script/source = "extends Node

@export var audio_player: AudioStreamPlayer
@export var phrases_to_play: Array[String]
@export var talking_sound: AudioStream


@onready var waiting_time: Dictionary = {
	\"a\": 0.07,
	\"e\": 0.07,
	\"u\": 0.1,
	\"i\": 0.1,
	\"o\": 0.07,
	\" \": 0.02,
	\",\": 0.7,
	\", \": 0.7,
	\".\": 1,
	\"!\": 1,
	\"?\": 1,
	\"...\": 1.2
}
func _ready() -> void:
	await get_tree().create_timer(2).timeout
	for p in phrases_to_play:
		await play_phrase(p)

func play_sound(sound: String, pitch_to_play):
	audio_player.stream = talking_sound
	audio_player.pitch_scale = pitch_to_play
	audio_player.play()
	var wait_time = waiting_time[sound] if sound in waiting_time else 0.07
	await get_tree().create_timer(wait_time).timeout
func play_phrase(phrase: String):
	
	var pitch = 1.3
	var parsed_phrase = phrase.to_lower().split(\"\")
	for s in range(parsed_phrase.size()):
		
		


		await play_sound(parsed_phrase[s], pitch)
"

