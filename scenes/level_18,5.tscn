[connection signal="body_entered" from="Player/Monitor_1/Computer/Window/XButton" to="Player/Monitor_1/Computer/Window/XButton" method="_on_body_entered"]
[connection signal="body_exited" from="Player/Monitor_1/Computer/Window/XButton" to="Player/Monitor_1/Computer/Window/XButton" method="_on_body_exited"]
[connection signal="closed" from="Player/Monitor_1/Computer/Window/XButton" to="Player/Monitor_1/Computer/Window" method="_on_x_button_closed"]
[connection signal="body_entered" from="Player/Monitor_1/Computer/Window/BridgeButton" to="Player/Monitor_1/Computer/Window/BridgeButton" method="_on_body_entered"]
[connection signal="body_exited" from="Player/Monitor_1/Computer/Window/BridgeButton" to="Player/Monitor_1/Computer/Window/BridgeButton" method="_on_body_exited"]
[connection signal="open_bridge" from="Player/Monitor_1/Computer/Window/BridgeButton" to="Table" method="_on_bridge_button_open_bridge"]
[connection signal="get_mouse_to_finish" from="Finish" to="Player" method="_on_finish_get_mouse_to_finish"]
[connection signal="table_changed" from="Table" to="Player" method="_on_table_table_changed"]
